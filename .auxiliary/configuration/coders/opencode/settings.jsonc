{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "build": {
      "mode": "primary",
      "model": "meta/muse-spark-1.3-contributor"
    },
    "plan": {
      "mode": "primary",
      "model": "meta/muse-spark-1.3-contributor"
    }
  },

  "mcp": {
    "agentmux": {
      "type": "local",
      "command": [
        "agentmux",
        "host",
        "mcp"
      ],
      "enabled": true,
      "timeout": 900000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "librovore": {
      "type": "local",
      "command": [
        "hatch",
        "run",
        "librovore",
        "--inscription.target-file",
        ".auxiliary/inscriptions/server.txt",
        "--inscription.level",
        "debug",
        "serve"
      ],
      "enabled": true
    },
    "nb": {
      "type": "local",
      "command": [
        "nb-mcp",
        "--notebook",
        "python-librovore",
        "--no-commit-signing"
      ],
      "enabled": true
    }
  },

  "permission": {
    "bash": {
      "*": "ask",
      "hatch run *": "allow",
      "hatch --env develop run *": "allow",
      "awk *": "allow",
      "cat *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "date": "allow",
      "date *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh browse *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh repo list *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh search issues *": "allow",
      "gh status *": "allow",
      "git add *": "allow",
      "git branch *": "allow",
      "git cat-file *": "allow",
      "git checkout *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git merge-base *": "allow",
      "git merge-tree *": "allow",
      "git range-diff *": "allow",
      "git rebase *": "allow",
      "git restore *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "git status *": "allow",
      "git worktree": "allow",
      "git worktree *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "nbspec *": "allow",
      "nl *": "allow",
      "npm run *": "allow",
      "od *": "allow",
      "openspec *": "allow",
      "printf": "allow",
      "printf *": "allow",
      "ps *": "allow",
      "pwd *": "allow",
      "readlink *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "set": "allow",
      "set *": "allow",
      "sleep": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "true": "allow",
      "true *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "xxd *": "allow"
    },
    "edit": "allow",
    "webfetch": "ask"
  },

  "formatter": {
    "ruff": {
      "disabled": true
    },
    "prettier": {
      "disabled": true
    }
  },

  "lsp": {
    "pyright": {
      "disabled": true
    }
  }
}
