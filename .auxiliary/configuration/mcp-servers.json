{
  "mcpServers": {
    "agentmux": {
      "command": "agentmux",
      "args": [
        "host", "mcp"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [ "-y", "@upstash/context7-mcp" ]
    },
    "librovore": {
      "command": "hatch",
      "args": [
        "run",
        "librovore",
        "--inscription.target-file",
        ".auxiliary/inscriptions/server.txt",
        "--inscription.level",
        "debug",
        "serve"
      ]
    },
    "nb": {
      "command": "nb-mcp",
      "args": [
        "--notebook", "python-librovore",
        "--no-commit-signing"
      ]
    }
  }
}
